# Supabase project: Settings > API. The publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The only address allowed to request a sign-in code.
ALLOWED_EMAIL=you@example.com

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Any long random string (openssl rand -hex 32).
CRON_SECRET=
